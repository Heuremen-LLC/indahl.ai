{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://indahl.ai/faultsguards/standard_v1.schema.json",
 "title": "Faults and Guards standard, version 1.1.0",
 "type": "object",
 "required": ["standard","reading_outcomes","outcome_reasons","statuses","status_reasons","read_statuses","claim_codes","faults","guards","families","guard_parts","recount_requirements","provenance","worked_examples","changes"],
 "additionalProperties": false,
 "$defs": {
  "outcome": {"enum": ["ABOVE","BELOW","CONSISTENT","CANNOT_TELL"]},
  "outcome_reason": {"enum": ["STRADDLES_EDGE","TOO_WIDE_TO_RESOLVE","NO_INTERVAL_FORMABLE"]},
  "status_reason": {"enum": ["NOT_RELEASED","UNREADABLE","METHOD_UNSTATED"]},
  "any_reason": {"enum": ["STRADDLES_EDGE","TOO_WIDE_TO_RESOLVE","NO_INTERVAL_FORMABLE","NOT_RELEASED","UNREADABLE","METHOD_UNSTATED"]},
  "test_source": {"enum": ["published","Heuremen LLC test"]},
  "mapping": {"type":"object","required":["relation","ids"],"additionalProperties":false,
    "properties":{"relation":{"const":"closest category"},"ids":{"type":"array","items":{"type":"object","required":["id","name"],"additionalProperties":false,"properties":{"id":{"type":"string"},"name":{"type":"string"}}}}}},
  "crosswalk": {"type":"object","required":["nist_ai_rmf_1_0"],"additionalProperties":false,
    "properties":{"nist_ai_rmf_1_0":{"$ref":"#/$defs/mapping"}}},
  "idname": {"type":"object","required":["id","definition"],"properties":{"id":{"type":"string"},"definition":{"type":"string"}}},
  "cannot_tell_rule": {"type":"object","required":["reason","when"],"additionalProperties":false,
    "properties":{"reason":{"$ref":"#/$defs/any_reason"},"when":{"type":"string"}}},
  "cannot_tell_rules": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/cannot_tell_rule"}},
  "interval": {"type":"object","required":["lower","upper","method","level"],"additionalProperties":false,
    "properties":{"lower":{"type":"number"},"upper":{"type":"number"},"method":{"type":"string","minLength":1},"level":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1}}},
  "figure": {"type":"object","required":["kind"],
    "properties":{"kind":{"enum":["band","bound","point"]},"lo":{"type":"number"},"hi":{"type":"number"},"lo_edge":{"enum":["closed","open"]},"hi_edge":{"enum":["closed","open"]},"bound":{"type":"number"},"bound_edge":{"enum":["closed","open"]},"point":{"type":"number"},"tolerance":{"type":"number","minimum":0}},
    "allOf": [
      {"if":{"properties":{"kind":{"const":"band"}},"required":["kind"]},"then":{"required":["lo","hi","lo_edge","hi_edge"]}},
      {"if":{"properties":{"kind":{"const":"bound"}},"required":["kind"]},"then":{"required":["bound","bound_edge"]}},
      {"if":{"properties":{"kind":{"const":"point"}},"required":["kind"]},"then":{"required":["point"]}}
    ]},
  "reading_record": {"type":"object","required":["quantity","figure","outcome"],
    "properties":{"quantity":{"type":"string"},"n":{"type":"integer","minimum":0},"count":{"type":"integer","minimum":0},"figure":{"$ref":"#/$defs/figure"},"null_value":{"type":"number"},"size_that_matters":{"type":"number"},"interval":{"anyOf":[{"$ref":"#/$defs/interval"},{"type":"null"}]},"outcome":{"$ref":"#/$defs/outcome"},"reason":{"$ref":"#/$defs/outcome_reason"}},
    "if":{"properties":{"outcome":{"const":"CANNOT_TELL"}},"required":["outcome"]},
    "then":{"required":["reason"]},
    "else":{"required":["interval"],"properties":{"reason":false,"interval":{"$ref":"#/$defs/interval"}}}},
  "status_record": {"type":"object","required":["id","status"],
    "properties":{"id":{"type":"string"},"status":{"enum":["PRESENT","ABSENT","CANNOT_TELL","NOT_APPLICABLE","APPLIED","NOT_APPLIED"]},"reason":{"$ref":"#/$defs/any_reason"},"note":{"type":"string"}},
    "if":{"properties":{"status":{"const":"CANNOT_TELL"}},"required":["status"]},
    "then":{"required":["reason"]},
    "else":{"properties":{"reason":false}}},
  "read_record": {"type":"object","required":["source","state"],
    "properties":{"source":{"type":"string"},"state":{"const":"NOTHING_RETURNED"}}}
 },
 "properties": {
  "standard": {"type":"object","required":["title","version","status","author","date","doi","all_versions_doi"],
    "properties":{"title":{"type":"string"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"enum":["draft","released","retired"]},"author":{"type":"string"},"date":{"type":"string","format":"date"},"schema":{"type":"string"},"doi":{"type":"string"},"all_versions_doi":{"type":"string"},"url":{"type":"string"},"previous_versions":{"type":"array","items":{"type":"object","required":["version","doi"],"properties":{"version":{"type":"string"},"doi":{"type":"string"}}}}}},
  "reading_outcomes": {"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/idname"}},
  "outcome_reasons": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/idname"}},
  "statuses": {"type":"array","minItems":6,"items":{"type":"object","required":["id","applies_to","definition"],"properties":{"id":{"type":"string"},"applies_to":{"type":"array","items":{"enum":["code","fault","guard"]}},"definition":{"type":"string"}}}},
  "status_reasons": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/idname"}},
  "read_statuses": {"type":"array","items":{"$ref":"#/$defs/idname"}},
  "families": {"type":"array","items":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string"}}}},
  "guard_parts": {"type":"array","items":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string"}}}},
  "claim_codes": {"type":"array","items":{"type":"object","required":["id","code","name","definition","applies_to","test","source","text_source","present_when","absent_when","cannot_tell_when","not_applicable_when","related_faults","crosswalk"],
    "properties":{"id":{"type":"string","pattern":"^QIA-F[0-9]+$"},"code":{"type":"string","pattern":"^F[0-9]+$"},"name":{"type":"string"},"definition":{"type":"string"},"applies_to":{"type":"string"},"test":{"type":"string"},"source":{"$ref":"#/$defs/test_source"},"text_source":{"type":"string"},"present_when":{"type":"string"},"absent_when":{"type":"string"},"cannot_tell_when":{"$ref":"#/$defs/cannot_tell_rules"},"not_applicable_when":{"type":"string"},"rests_on_reading":{"type":"boolean"},"notes":{"type":"array","items":{"type":"string"}},"related_faults":{"type":"array","items":{"type":"string","pattern":"^FLT-[0-9]{2}$"}},"crosswalk":{"$ref":"#/$defs/crosswalk"}}}},
  "faults": {"type":"array","items":{"type":"object","required":["id","number","family","name","definition","published_text","applies_to","test","source","text_source","needs","evidence_kind","present_when","absent_when","cannot_tell_when","not_applicable_when","guards","crosswalk"],
    "properties":{"id":{"type":"string","pattern":"^FLT-[0-9]{2}$"},"number":{"type":"integer","minimum":1},"family":{"enum":["I","II","III","IV","V","VI","VII","VIII"]},"name":{"type":"string"},"definition":{"type":"string"},"published_text":{"type":"array","items":{"type":"string"}},"applies_to":{"type":"string"},"test":{"type":"string"},"source":{"$ref":"#/$defs/test_source"},"text_source":{"type":"string"},"needs":{"type":"string"},"evidence_kind":{"enum":["released material","process record"]},"present_when":{"type":"string"},"absent_when":{"type":"string"},"cannot_tell_when":{"$ref":"#/$defs/cannot_tell_rules"},"not_applicable_when":{"type":"string"},"rests_on_reading":{"type":"boolean"},"notes":{"type":"array","items":{"type":"string"}},"third_party_note":{"type":"string"},"guards":{"type":"array","items":{"type":"string","pattern":"^GRD-[0-9]{2}$"}},"crosswalk":{"$ref":"#/$defs/crosswalk"}},
    "if":{"properties":{"evidence_kind":{"const":"process record"}},"required":["evidence_kind"]},"then":{"required":["third_party_note"]}}},
  "guards": {"type":"array","items":{"type":"object","required":["id","number","part","name","published_text","addresses","test","source","text_source","applied_when","not_applied_when","cannot_tell_when","not_applicable_when"],
    "properties":{"id":{"type":"string","pattern":"^GRD-[0-9]{2}$"},"number":{"type":"integer","minimum":1},"part":{"enum":["I","II","III","IV"]},"name":{"type":"string"},"published_text":{"type":"array","items":{"type":"string"}},"addresses":{"type":"array","items":{"type":"string","pattern":"^FLT-[0-9]{2}$"}},"test":{"type":"string"},"source":{"$ref":"#/$defs/test_source"},"text_source":{"type":"string"},"applied_when":{"type":"string"},"not_applied_when":{"type":"string"},"cannot_tell_when":{"$ref":"#/$defs/cannot_tell_rules"},"not_applicable_when":{"type":"string"}}}},
  "recount_requirements": {"type":"array","items":{"type":"object","required":["id","name","text","guards"],"properties":{"id":{"type":"string","pattern":"^REQ-[0-9]{2}$"},"name":{"type":"string"},"text":{"type":"string"},"guards":{"type":"array","items":{"type":"string"}}}}},
  "provenance": {"type":"object","required":["published_wording","heuremen_llc_wording","source_values"],"properties":{"published_wording":{"type":"array","items":{"type":"string"}},"heuremen_llc_wording":{"type":"array","items":{"type":"string"}},"source_values":{"type":"array","items":{"type":"string"}}}},
  "worked_examples": {"type":"array","items":{"type":"object","required":["id","title","reading","recorded_in_plan","note"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"reading":{"$ref":"#/$defs/reading_record"},"recorded_in_plan":{"$ref":"#/$defs/outcome"},"note":{"type":"string"}}}},
  "changes": {"type":"array","items":{"type":"object","required":["version","summary"],"properties":{"version":{"type":"string"},"date":{"type":"string"},"summary":{"type":"string"}}}}
 }
}
