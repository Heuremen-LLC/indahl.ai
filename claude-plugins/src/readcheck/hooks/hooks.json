{
  "description": "Readcheck gate: a git commit that stages a reading needs a complete CHECK.json beside it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; $P -c 1 >/dev/null 2>&1 || P=python; exec $P \"${CLAUDE_PLUGIN_ROOT}/scripts/readcheck.py\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}